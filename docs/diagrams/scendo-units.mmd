%%{init: {"theme": "base", "themeVariables": {"fontSize": "18px", "fontFamily": "Helvetica, Arial, sans-serif"}} }%%
flowchart TB
  subgraph kill["Kill — done"]
    direction LR
    U00["00–05<br/>Gate A pass"] --> U06["06–07<br/>Gate B fail"]
    U06 --> U08["08 Decide<br/>atlas-only"]
  end

  subgraph lock["Atlas lock — done"]
    direction LR
    PR["Protocol"] --> CL["Clarify"]
    CL --> AN["Analyze"]
    AN --> SE["Seal"]
  end

  subgraph run["Atlas execute — done"]
    direction LR
    U10["10 Reproduce<br/>Gate D pass"] --> U11["11 Inventory"]
    U11 --> U12["12 Expansion<br/>Gate E pass"]
    U12 --> U13["13 Figures"]
    U13 --> U14["14 Converge<br/>Gate F pass"]
  end

  subgraph decide["Atlas Decide — done"]
    direction LR
    DEC["Paper as written<br/>ICI negative"]
  end

  subgraph scribe["Scribe — done"]
    direction LR
    SC["Manuscript<br/>core + expansion"]
  end

  subgraph archive["Archive — done"]
    direction LR
    AR["Leftovers in<br/>EXPLORE.md"]
  end

  U08 --> PR
  SE --> U10
  U14 --> DEC
  DEC --> SC
  SC --> AR

  classDef done fill:#E4EDE4,stroke:#3D5A3D,color:#1A1A1A
  classDef now fill:#FFF3C4,stroke:#8A6D00,color:#1A1A1A
  classDef later fill:#EEEEEE,stroke:#666666,color:#1A1A1A
  class U00,U06,U08,PR,CL,AN,SE,U10,U11,U12,U13,U14,DEC,SC,AR done
