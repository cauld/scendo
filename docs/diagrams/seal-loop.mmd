%%{init: {"theme": "base", "themeVariables": {"fontSize": "18px", "fontFamily": "Helvetica, Arial, sans-serif"}} }%%
flowchart TB
  subgraph lock["1. Lock — already done"]
    direction LR
    E[Explore] --> Q[Question<br/>+ Claims]
    Q --> K[Kill]
    K --> P[Protocol]
    P --> CA[Clarify<br/>+ Analyze]
    CA --> S[Seal<br/>git SHA + OSF]
  end

  subgraph exec["2. Execute — NOW"]
    direction LR
    U[Unit packet] --> R[Say Run]
    R --> H[Human marks<br/>that gate]
    H --> N[Next unit]
    N --> U
  end

  subgraph decide["3. After Unit 08"]
    direction LR
    CV[Converge] --> D{Decide}
    D --> ST[Stop]
    D --> AT[Atlas-only]
    D --> FP[Full paper]
  end

  S --> U
  H -.->|Unit 08| CV

  classDef done fill:#E4EDE4,stroke:#3D5A3D,color:#1A1A1A
  classDef now fill:#FFF3C4,stroke:#8A6D00,color:#1A1A1A
  classDef later fill:#EEEEEE,stroke:#666666,color:#1A1A1A
  class E,Q,K,P,CA,S done
  class U,R,H,N now
  class CV,D,ST,AT,FP later
